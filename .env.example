# Бот челленджа pocketSMM — отдельный проект Railway, ни с чем не связан.

# --- Telegram ---
BOT_TOKEN=123456:ABC...
# Кураторы: Telegram ID через запятую (получают оплаты, задания и вопросы, отвечают реплаем)
ADMIN_IDS=111111111,222222222

# --- Robokassa: магазин pocketMarketolog ---
ROBOKASSA_LOGIN=pocketMarketolog
ROBOKASSA_PASSWORD1=xxxxxxxx
ROBOKASSA_PASSWORD2=yyyyyyyy
ROBOKASSA_IS_TEST=0

# --- Продукт ---
PRODUCT_NAME=Челлендж «Продающие ролики через нейросеть»
PAYMENT_AMOUNT=5000.00
# Секунд между днями челленджа (86400 = сутки; для теста можно 60)
DAY_INTERVAL=86400

# --- Документы: если пусто, бот сам показывает текст из docs/offer.md и docs/privacy.md ---
OFFER_URL=
PRIVACY_URL=

# --- Реквизиты продавца ---
SELLER_STATUS=Самозанятый
SELLER_NAME=Ом Алина Владимировна
SELLER_INN=540361887252
SELLER_CITY=Российская Федерация
CONTACT_EMAIL=ohm.alina@mail.ru
CONTACT_TELEGRAM=@ohm_ali
CONTACT_PHONE=

# На Railway — Volume с путём /data
DB_PATH=/data/data.sqlite3
